{% comment %}
  PCA™ Wardrobe Landing Section
  Path: sections/pca-wardrobe-landing.liquid
  Purpose: Luxury conversion homepage for The Rare Ones Wardrobe launch.
  Source of truth: docs/launch-blueprint.md — do not diverge from its section order or copy without updating both.
  Trust rule: no fake reviews, no fake urgency/scarcity, no invented shipping/return facts — bracketed
  merchant settings below render nothing until filled in with a real value. See docs/launch-blueprint.md.
{% endcomment %}

<section class="pca-wardrobe" data-section-id="{{ section.id }}">

  {%- comment -%} ── 1. Announcement bar ── {%- endcomment -%}
  <div class="pcaw-announce">
    <div class="pcaw-announce__track">
      <span>{{ section.settings.announce_message_1 }}</span>
      <span>{{ section.settings.announce_message_2 }}</span>
    </div>
  </div>

  {%- comment -%} ── 2. Video hero ── {%- endcomment -%}
  <div class="pcaw-hero">
    <div class="pcaw-hero__media">
      {%- comment -%}
        Video files can't live in theme assets (Shopify rejects them, which fails the whole
        GitHub sync). Upload the hero video to Content → Files and paste its CDN URL into
        the "Hero video URL" setting. Until then the poster renders as a static hero image.
      {%- endcomment -%}
      {%- if section.settings.hero_video_url != blank -%}
        <video class="pcaw-hero__video" autoplay muted loop playsinline
          poster="{% if section.settings.hero_poster != blank %}{{ section.settings.hero_poster | image_url: width: 1600 }}{% else %}{{ 'pca-wardrobe-hero-poster.jpg' | asset_url }}{% endif %}">
          <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.hero_poster != blank -%}
        {{ section.settings.hero_poster | image_url: width: 1800 | image_tag: loading: 'eager', class: 'pcaw-hero__video', alt: section.settings.hero_heading }}
      {%- else -%}
        <img class="pcaw-hero__video" src="{{ 'pca-wardrobe-hero-poster.jpg' | asset_url }}" alt="{{ section.settings.hero_heading | escape }}" loading="eager" width="1280" height="720">
      {%- endif -%}
      <div class="pcaw-hero__scrim"></div>
    </div>

    <div class="pcaw-hero__content">
      <h1>{{ section.settings.hero_heading }}</h1>
      <p class="pcaw-hero__sub">{{ section.settings.hero_subheading }}</p>

      <div class="pcaw-hero__ctas">
        <a class="pcaw-btn pcaw-btn--primary" href="{{ section.settings.hero_primary_url | default: '#pcaw-collection' }}">
          {{ section.settings.hero_primary_text }}
        </a>
        <a class="pcaw-btn pcaw-btn--ghost" href="{{ section.settings.hero_secondary_url | default: '#pcaw-size-guide' }}">
          {{ section.settings.hero_secondary_text }}
        </a>
      </div>

      <p class="pcaw-hero__trust">{{ section.settings.hero_trust_microcopy }}</p>
      {%- if section.settings.hero_discount_teaser != blank -%}
        <p class="pcaw-hero__teaser">{{ section.settings.hero_discount_teaser }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 3. Trust strip ── {%- endcomment -%}
  <div class="pcaw-trust-strip">
    <ul>
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%} ── 4. Featured collection grid ── {%- endcomment -%}
  <div class="pcaw-collection" id="pcaw-collection">
    <div class="pcaw-section-head">
      <p class="pcaw-eyebrow">{{ section.settings.collection_eyebrow }}</p>
      <h2>{{ section.settings.collection_heading }}</h2>
    </div>
    <div class="pcaw-collection__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign p = block.settings.product -%}
          <a class="pcaw-product-card" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" {{ block.shopify_attributes }}>
            <div class="pcaw-product-card__media">
              {%- if block.settings.image_override != blank -%}
                {{ block.settings.image_override | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'pcaw-product-card__img' }}
              {%- elsif p != blank and p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'pcaw-product-card__img' }}
              {%- else -%}
                <div class="pcaw-product-card__placeholder"></div>
              {%- endif -%}
            </div>
            <p class="pcaw-product-card__name">
              {%- if p != blank -%}{{ p.title }}{%- else -%}{{ block.settings.name_fallback }}{%- endif -%}
            </p>
            <p class="pcaw-product-card__desc">{{ block.settings.descriptor }}</p>
            <p class="pcaw-product-card__price">
              {%- if p != blank -%}{{ p.price | money }}{%- else -%}{{ block.settings.price_fallback }}{%- endif -%}
            </p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ── 5. Build Their Wardrobe — Buy 2 / Buy 3 offer ── {%- endcomment -%}
  <div class="pcaw-offer">
    <div class="pcaw-offer__inner">
      <p class="pcaw-eyebrow">{{ section.settings.offer_eyebrow }}</p>
      <h2>{{ section.settings.offer_heading }}</h2>
      <div class="pcaw-offer__tiers">
        <div class="pcaw-offer__tier">
          <span class="pcaw-offer__tier-num">2</span>
          <p>{{ section.settings.offer_tier_2_text }}</p>
        </div>
        <div class="pcaw-offer__tier">
          <span class="pcaw-offer__tier-num">3</span>
          <p>{{ section.settings.offer_tier_3_text }}</p>
        </div>
      </div>
      <p class="pcaw-offer__note">{{ section.settings.offer_note }}</p>
    </div>
  </div>

  {%- comment -%} ── 6. Bath Bonnet add-on ── {%- endcomment -%}
  <div class="pcaw-addon">
    <div class="pcaw-addon__media">
      {%- if section.settings.addon_image != blank -%}
        {{ section.settings.addon_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'pcaw-addon__img' }}
      {%- else -%}
        <div class="pcaw-addon__placeholder"></div>
      {%- endif -%}
    </div>
    <div class="pcaw-addon__content">
      <p class="pcaw-eyebrow">{{ section.settings.addon_eyebrow }}</p>
      <h2>{{ section.settings.addon_heading }}</h2>
      <p class="pcaw-addon__body">{{ section.settings.addon_body }}</p>
      {%- if section.settings.addon_product != blank -%}
        <a class="pcaw-btn pcaw-btn--primary" href="{{ section.settings.addon_product.url }}">{{ section.settings.addon_cta_text }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 7. Why Hairless Cats Need Layers — education ── {%- endcomment -%}
  <div class="pcaw-education">
    <div class="pcaw-education__content">
      <p class="pcaw-eyebrow">{{ section.settings.education_eyebrow }}</p>
      <h2>{{ section.settings.education_heading }}</h2>
      <p>{{ section.settings.education_body }}</p>
    </div>
    <div class="pcaw-education__media">
      {%- if section.settings.education_image != blank -%}
        {{ section.settings.education_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'pcaw-education__img' }}
      {%- else -%}
        <div class="pcaw-education__placeholder"></div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 8. Style guide / comparison ── {%- endcomment -%}
  <div class="pcaw-style-guide">
    <div class="pcaw-section-head">
      <p class="pcaw-eyebrow">{{ section.settings.style_guide_eyebrow }}</p>
      <h2>{{ section.settings.style_guide_heading }}</h2>
    </div>
    <div class="pcaw-style-guide__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'style_guide_item' -%}
          <div class="pcaw-style-guide__item" {{ block.shopify_attributes }}>
            <span class="pcaw-style-guide__label">{{ block.settings.use_case }}</span>
            <p class="pcaw-style-guide__product">{{ block.settings.recommended_product }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ── 9. Size guide ── {%- endcomment -%}
  <div class="pcaw-size-guide" id="pcaw-size-guide">
    <div class="pcaw-size-guide__inner">
      <p class="pcaw-eyebrow">{{ section.settings.size_guide_eyebrow }}</p>
      <h2>{{ section.settings.size_guide_heading }}</h2>
      <p class="pcaw-size-guide__body">{{ section.settings.size_guide_body }}</p>
      {%- if section.settings.size_chart_image != blank -%}
        <div class="pcaw-size-guide__chart">
          {{ section.settings.size_chart_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        </div>
      {%- endif -%}
      {%- if section.settings.support_email != blank -%}
        <a class="pcaw-btn pcaw-btn--ghost" href="mailto:{{ section.settings.support_email }}">{{ section.settings.size_guide_cta_text }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 10. New Brand, Real Craft — trust section ── {%- endcomment -%}
  <div class="pcaw-brand-trust">
    <div class="pcaw-brand-trust__founder">
      <p class="pcaw-eyebrow">{{ section.settings.founder_eyebrow }}</p>
      <blockquote>{{ section.settings.founder_note }}</blockquote>
      {%- if section.settings.founder_image != blank -%}
        <div class="pcaw-brand-trust__founder-media">
          {{ section.settings.founder_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
        </div>
      {%- endif -%}
    </div>
    <div class="pcaw-brand-trust__promise">
      <h2>{{ section.settings.new_brand_heading }}</h2>
      <p>{{ section.settings.new_brand_body }}</p>
      <ul>
        {%- for block in section.blocks -%}
          {%- if block.type == 'promise_item' -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- comment -%} ── 11. Guarantee / policy ── {%- endcomment -%}
  <div class="pcaw-guarantee">
    <div class="pcaw-guarantee__grid">
      <div class="pcaw-guarantee__item">
        <h3>{{ section.settings.sizing_policy_heading }}</h3>
        <p>
          {{ section.settings.sizing_policy_body }}
          {%- if section.settings.support_email != blank %} Email <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a> for a second opinion before checkout.{% endif -%}
        </p>
      </div>
      <div class="pcaw-guarantee__item">
        <h3>{{ section.settings.hygiene_policy_heading }}</h3>
        <p>
          {{ section.settings.hygiene_policy_body }}
          {%- if section.settings.return_window_days != blank %} Unworn, unwashed items in original packaging can be returned within {{ section.settings.return_window_days }} days of delivery.{% endif -%}
        </p>
      </div>
      <div class="pcaw-guarantee__item">
        <h3>{{ section.settings.shipping_policy_heading }}</h3>
        <p>
          {%- if section.settings.processing_days != blank and section.settings.transit_days != blank -%}
            Orders are processed within {{ section.settings.processing_days }}. Most U.S. orders arrive within {{ section.settings.transit_days }} after processing. Delivery times may vary by location and carrier conditions.
          {%- else -%}
            Full shipping timelines are shown at checkout before you pay.
          {%- endif -%}
        </p>
      </div>
    </div>
  </div>

  {%- comment -%} ── 12. FAQ ── {%- endcomment -%}
  <div class="pcaw-faq">
    <h2>{{ section.settings.faq_heading }}</h2>

    <details>
      <summary>Is this only for Sphynx cats?</summary>
      <p>Rare Skin pieces are cut for Sphynx, Devon Rex, Cornish Rex, Peterbald, and other hairless or thin-coated breeds. If your cat runs cold or has sensitive skin, these are built for them.</p>
    </details>

    <details>
      <summary>How do I choose a size?</summary>
      <p>Every product page has a size chart based on chest measurement and weight — not breed guesswork. Measure once and you'll size correctly across the whole wardrobe.</p>
    </details>

    <details>
      <summary>What if my cat is between sizes?</summary>
      <p>
        Size up. A slightly looser fit is more comfortable — and safer for hairless skin — than anything snug.
        {%- if section.settings.support_email != blank %} Email your measurements to <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a> if you want a second opinion before you order.{% endif -%}
      </p>
    </details>

    <details>
      <summary>Are items sold separately?</summary>
      <p>Yes — every piece in the Alley Scholar Collection is sold individually so you can build exactly the wardrobe you want.</p>
    </details>

    <details>
      <summary>How long does shipping take?</summary>
      <p>
        {%- if section.settings.processing_days != blank and section.settings.transit_days != blank -%}
          Orders are processed within {{ section.settings.processing_days }}. Most U.S. orders arrive within {{ section.settings.transit_days }} after processing. Delivery times may vary by location and carrier conditions.
        {%- else -%}
          Full shipping timelines are shown at checkout before you pay.
        {%- endif -%}
      </p>
    </details>

    <details>
      <summary>Can worn pet clothing be returned?</summary>
      <p>
        For hygiene reasons, we can't accept returns on worn apparel or bath accessories.
        {%- if section.settings.return_window_days != blank %} Unworn items in original condition can be returned within {{ section.settings.return_window_days }} days.{% endif %}
        If sizing feels off before your cat wears it, email us and we'll help you fix it before it becomes a problem.
      </p>
    </details>

    <details>
      <summary>Is the bath bonnet safe?</summary>
      <p>The Rare Skin Bath Bonnet covers the ears only, during bath time, under your supervision. It isn't designed for extended wear — remove it once bath time is done.</p>
    </details>

    <details>
      <summary>Do I need to supervise my cat while wearing these?</summary>
      <p>Yes. Like any pet apparel, supervise your cat while wearing any Pussycat Alley piece, especially the first few times, and remove it if your cat shows any discomfort.</p>
    </details>

    <details>
      <summary>Is this a new brand?</summary>
      <p>Yes — this is our first drop. We don't have reviews yet because no one's worn it yet. Pussycat Alley was built for Sphynx, Devon Rex, Cornish Rex, Peterbald, and other hairless-cat families who need care, warmth, and products designed around their cats' specific needs.</p>
    </details>

    <details>
      <summary>How do I contact support?</summary>
      <p>
        {%- if section.settings.support_email != blank -%}
          Email us at <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a> — ask us before you order if you're unsure about sizing.
        {%- else -%}
          Use the contact page to reach our team — ask us before you order if you're unsure about sizing.
        {%- endif -%}
      </p>
    </details>
  </div>

  {%- comment -%} ── 13. Final CTA ── {%- endcomment -%}
  <div class="pcaw-final-cta">
    <div class="pcaw-final-cta__inner">
      <h2>{{ section.settings.final_cta_heading }}</h2>
      <p>{{ section.settings.final_cta_body }}</p>
      <a class="pcaw-btn pcaw-btn--primary" href="{{ section.settings.final_cta_url | default: '#pcaw-collection' }}">{{ section.settings.final_cta_text }}</a>
    </div>
  </div>

</section>

<style>
  :root {
    --pcaw-obsidian: #0B0B0C;
    --pcaw-ivory: #F5F0E6;
    --pcaw-gold: #B08D57;
    --pcaw-charcoal: #1C1B1A;
  }

  .pca-wardrobe {
    background: var(--pcaw-obsidian);
    color: var(--pcaw-ivory);
    font-family: "DM Sans", system-ui, sans-serif;
  }

  .pca-wardrobe h1,
  .pca-wardrobe h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 300;
    letter-spacing: -.02em;
    margin: 0;
  }

  .pcaw-eyebrow {
    color: var(--pcaw-gold);
    text-transform: uppercase;
    letter-spacing: .22em;
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 18px;
  }

  .pcaw-btn {
    display: inline-block;
    width: fit-content;
    padding: 18px 38px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--pcaw-gold);
    transition: background .2s, color .2s;
    font-family: inherit;
  }

  .pcaw-btn--primary {
    background: var(--pcaw-gold);
    color: var(--pcaw-obsidian);
  }

  .pcaw-btn--primary:hover {
    background: transparent;
    color: var(--pcaw-gold);
  }

  .pcaw-btn--ghost {
    background: transparent;
    color: var(--pcaw-gold);
  }

  .pcaw-btn--ghost:hover {
    background: rgba(176, 141, 87, .1);
  }

  .pcaw-section-head {
    max-width: 640px;
    margin: 0 auto 56px;
    text-align: center;
  }

  /* ── 1. Announcement bar ── */
  .pcaw-announce {
    background: var(--pcaw-charcoal);
    border-bottom: 1px solid rgba(176, 141, 87, .18);
    overflow: hidden;
    padding: 12px 0;
  }

  .pcaw-announce__track {
    display: flex;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
    text-align: center;
    font-size: 13px;
    letter-spacing: .04em;
    color: var(--pcaw-ivory);
  }

  /* ── 2. Hero ── */
  .pcaw-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .pcaw-hero__media {
    position: absolute;
    inset: 0;
  }

  .pcaw-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcaw-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11,11,12,.92) 0%, rgba(11,11,12,.35) 45%, rgba(11,11,12,.55) 100%);
  }

  .pcaw-hero__content {
    position: relative;
    z-index: 1;
    padding: 0 clamp(28px, 6vw, 96px);
    max-width: 900px;
  }

  .pcaw-hero h1 {
    font-size: clamp(46px, 7vw, 96px);
    line-height: .98;
    margin-bottom: 24px;
  }

  .pcaw-hero__sub {
    color: var(--pcaw-ivory);
    opacity: .82;
    font-size: 19px;
    line-height: 1.6;
    max-width: 620px;
    margin: 0 0 36px;
  }

  .pcaw-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pcaw-hero__trust {
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(245, 240, 230, .6);
    margin: 0 0 8px;
  }

  .pcaw-hero__teaser {
    font-size: 14px;
    color: var(--pcaw-gold);
    margin: 0;
  }

  /* ── 3. Trust strip ── */
  .pcaw-trust-strip {
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-trust-strip ul {
    list-style: none;
    margin: 0;
    padding: 22px clamp(28px, 6vw, 96px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
  }

  .pcaw-trust-strip li {
    font-size: 12px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(245, 240, 230, .7);
  }

  /* ── 4. Collection grid ── */
  .pcaw-collection {
    padding: 100px clamp(28px, 7vw, 110px);
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .pcaw-product-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .pcaw-product-card__media {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--pcaw-charcoal);
    margin-bottom: 20px;
  }

  .pcaw-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
  }

  .pcaw-product-card:hover .pcaw-product-card__img {
    transform: scale(1.03);
  }

  .pcaw-product-card__placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(176, 141, 87, .1), transparent 60%);
  }

  .pcaw-product-card__name {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .pcaw-product-card__desc {
    font-size: 13px;
    color: rgba(245, 240, 230, .6);
    margin: 0 0 8px;
    line-height: 1.5;
  }

  .pcaw-product-card__price {
    font-size: 14px;
    color: var(--pcaw-gold);
    margin: 0;
  }

  /* ── 5. Offer ── */
  .pcaw-offer {
    padding: 100px clamp(28px, 7vw, 110px);
    text-align: center;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
    background: radial-gradient(ellipse at center, rgba(176, 141, 87, .06), transparent 65%);
  }

  .pcaw-offer__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .pcaw-offer h2 {
    font-size: clamp(36px, 5vw, 60px);
    margin: 16px 0 48px;
  }

  .pcaw-offer__tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .pcaw-offer__tier {
    border: 1px solid rgba(176, 141, 87, .3);
    padding: 32px 24px;
  }

  .pcaw-offer__tier-num {
    display: block;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 48px;
    color: var(--pcaw-gold);
    line-height: 1;
    margin-bottom: 12px;
  }

  .pcaw-offer__tier p {
    margin: 0;
    font-size: 15px;
    color: rgba(245, 240, 230, .8);
  }

  .pcaw-offer__note {
    font-size: 13px;
    color: rgba(245, 240, 230, .5);
  }

  /* ── 6. Bath Bonnet add-on ── */
  .pcaw-addon {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-addon__media {
    position: relative;
    overflow: hidden;
    background: var(--pcaw-charcoal);
  }

  .pcaw-addon__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pcaw-addon__placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(176, 141, 87, .1), transparent 60%);
  }

  .pcaw-addon__content {
    padding: 72px clamp(28px, 6vw, 90px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }

  .pcaw-addon h2 {
    font-size: clamp(32px, 4vw, 52px);
  }

  .pcaw-addon__body {
    color: rgba(245, 240, 230, .75);
    font-size: 16px;
    line-height: 1.7;
    max-width: 460px;
    margin: 0 0 12px;
  }

  /* ── 7. Education ── */
  .pcaw-education {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-education__content {
    padding: 72px clamp(28px, 6vw, 90px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .pcaw-education h2 {
    font-size: clamp(32px, 4vw, 52px);
  }

  .pcaw-education__content p {
    color: rgba(245, 240, 230, .75);
    font-size: 16px;
    line-height: 1.75;
    max-width: 480px;
    margin: 0;
  }

  .pcaw-education__media {
    position: relative;
    overflow: hidden;
    background: var(--pcaw-charcoal);
  }

  .pcaw-education__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pcaw-education__placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(176, 141, 87, .1), transparent 60%);
  }

  /* ── 8. Style guide ── */
  .pcaw-style-guide {
    padding: 100px clamp(28px, 7vw, 110px);
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-style-guide__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-style-guide__item {
    padding: 32px 28px;
    border-right: 1px solid rgba(176, 141, 87, .14);
    border-bottom: 1px solid rgba(176, 141, 87, .14);
  }

  .pcaw-style-guide__label {
    display: block;
    color: var(--pcaw-gold);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .pcaw-style-guide__product {
    margin: 0;
    font-size: 16px;
  }

  /* ── 9. Size guide ── */
  .pcaw-size-guide {
    padding: 100px clamp(28px, 7vw, 110px);
    text-align: center;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-size-guide__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .pcaw-size-guide h2 {
    font-size: clamp(32px, 4vw, 52px);
    margin: 16px 0 24px;
  }

  .pcaw-size-guide__body {
    color: rgba(245, 240, 230, .75);
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 32px;
  }

  .pcaw-size-guide__chart {
    margin-bottom: 32px;
  }

  .pcaw-size-guide__chart img {
    max-width: 100%;
    border: 1px solid rgba(176, 141, 87, .2);
  }

  /* ── 10. New brand trust ── */
  .pcaw-brand-trust {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-brand-trust__founder,
  .pcaw-brand-trust__promise {
    padding: 80px clamp(28px, 6vw, 90px);
  }

  .pcaw-brand-trust__founder {
    border-right: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-brand-trust__founder blockquote {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 300;
    line-height: 1.3;
    margin: 0 0 28px;
  }

  .pcaw-brand-trust__founder-media img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(176, 141, 87, .3);
  }

  .pcaw-brand-trust__promise h2 {
    font-size: clamp(28px, 4vw, 44px);
    margin-bottom: 20px;
  }

  .pcaw-brand-trust__promise p {
    color: rgba(245, 240, 230, .75);
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 28px;
  }

  .pcaw-brand-trust__promise ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pcaw-brand-trust__promise li {
    padding-left: 20px;
    position: relative;
    font-size: 15px;
    color: rgba(245, 240, 230, .85);
  }

  .pcaw-brand-trust__promise li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--pcaw-gold);
  }

  /* ── 11. Guarantee ── */
  .pcaw-guarantee {
    padding: 80px clamp(28px, 7vw, 110px);
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-guarantee__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .pcaw-guarantee__item {
    padding: 40px 32px;
    border: 1px solid rgba(176, 141, 87, .14);
  }

  .pcaw-guarantee__item h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 300;
    font-size: 22px;
    margin: 0 0 14px;
  }

  .pcaw-guarantee__item p {
    color: rgba(245, 240, 230, .7);
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .pcaw-guarantee__item a {
    color: var(--pcaw-gold);
  }

  /* ── 12. FAQ ── */
  .pcaw-faq {
    padding: 100px clamp(28px, 7vw, 110px);
    max-width: 940px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-faq h2 {
    font-size: clamp(32px, 4vw, 52px);
    margin-bottom: 40px;
    text-align: center;
  }

  .pcaw-faq details {
    border-top: 1px solid rgba(176, 141, 87, .18);
    padding: 22px 0;
  }

  .pcaw-faq details:last-child {
    border-bottom: 1px solid rgba(176, 141, 87, .18);
  }

  .pcaw-faq summary {
    cursor: pointer;
    font-size: 17px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pcaw-faq summary::-webkit-details-marker { display: none; }

  .pcaw-faq summary::after {
    content: '+';
    font-size: 20px;
    color: var(--pcaw-gold);
    margin-left: 16px;
    flex-shrink: 0;
  }

  .pcaw-faq details[open] summary::after { content: '\2212'; }

  .pcaw-faq details p {
    margin: 14px 0 0;
    color: rgba(245, 240, 230, .75);
    font-size: 15px;
    line-height: 1.7;
  }

  .pcaw-faq details a { color: var(--pcaw-gold); }

  /* ── 13. Final CTA ── */
  .pcaw-final-cta {
    padding: 120px clamp(28px, 7vw, 110px);
    text-align: center;
  }

  .pcaw-final-cta__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .pcaw-final-cta h2 {
    font-size: clamp(36px, 5vw, 64px);
    margin-bottom: 20px;
  }

  .pcaw-final-cta p {
    color: rgba(245, 240, 230, .75);
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 36px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .pcaw-collection__grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .pcaw-offer__tiers,
    .pcaw-style-guide__grid {
      grid-template-columns: 1fr;
    }

    .pcaw-addon,
    .pcaw-education,
    .pcaw-brand-trust {
      grid-template-columns: 1fr;
    }

    .pcaw-addon__media,
    .pcaw-education__media {
      min-height: 320px;
    }

    .pcaw-brand-trust__founder {
      border-right: none;
      border-bottom: 1px solid rgba(176, 141, 87, .18);
    }

    .pcaw-guarantee__grid {
      grid-template-columns: 1fr;
    }

    .pcaw-collection,
    .pcaw-offer,
    .pcaw-style-guide,
    .pcaw-size-guide,
    .pcaw-guarantee,
    .pcaw-faq,
    .pcaw-final-cta {
      padding: 56px 24px;
    }

    .pcaw-addon__content,
    .pcaw-education__content,
    .pcaw-brand-trust__founder,
    .pcaw-brand-trust__promise {
      padding: 48px 24px;
    }
  }

  @media (max-width: 560px) {
    .pcaw-collection__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

