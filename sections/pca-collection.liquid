{% comment %}
  PCA™ Collection Page
  Path: sections/pca-collection.liquid
  Luxury editorial collection grid — obsidian/ivory/gold system. No filters at launch
  (clean over clever); pagination only when needed.
{% endcomment %}

<nav class="pcac-topbar">
  <a class="pcac-topbar__brand" href="{{ routes.root_url }}">PUSSYCAT ALLEY™</a>
  <div class="pcac-topbar__links">
    <a href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
  </div>
</nav>

<section class="pcac" data-section-id="{{ section.id }}">
  <header class="pcac__head">
    <p class="pcac__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="pcac__intro">{{ collection.description }}</div>
    {%- elsif section.settings.intro != blank -%}
      <p class="pcac__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="pcac__grid">
        {%- for product in collection.products -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          <a class="pcac-card" href="{{ product.url }}">
            <div class="pcac-card__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'pcac-card__img pcac-card__img--primary', alt: product.title }}
                {%- if product.images[1] -%}
                  {{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', class: 'pcac-card__img pcac-card__img--secondary', alt: product.title }}
                {%- endif -%}
              {%- else -%}
                <div class="pcac-card__placeholder"></div>
              {%- endif -%}
              {%- unless product.available -%}
                <span class="pcac-card__badge">Sold Out</span>
              {%- endunless -%}
            </div>
            <p class="pcac-card__name">{{ product.title }}</p>
            <p class="pcac-card__price">
              {%- if v.compare_at_price > v.price -%}
                <s>{{ v.compare_at_price | money }}</s>
              {%- endif -%}
              {{ v.price | money }}
            </p>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pcac__pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="pcac__empty">
        <p>Nothing here yet — the wardrobe is being prepared.</p>
        <a class="pcac-btn" href="{{ routes.root_url }}">Return Home</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

<style>
  :root {
    --pcac-obsidian: #0B0B0C;
    --pcac-ivory: #F5F0E6;
    --pcac-gold: #B08D57;
    --pcac-charcoal: #1C1B1A;
  }

  body { background: var(--pcac-obsidian); }

  .pcac-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px clamp(20px, 4vw, 48px);
    background: var(--pcac-obsidian);
    border-bottom: 1px solid rgba(176,141,87,.18);
    font-family: "DM Sans", system-ui, sans-serif;
  }

  .pcac-topbar__brand {
    color: var(--pcac-ivory);
    text-decoration: none;
    letter-spacing: .28em;
    font-size: 13px;
    font-weight: 700;
  }

  .pcac-topbar__links a {
    color: rgba(245,240,230,.75);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .pcac-topbar__links a:hover { color: var(--pcac-gold); }

  .pcac {
    background: var(--pcac-obsidian);
    color: var(--pcac-ivory);
    font-family: "DM Sans", system-ui, sans-serif;
    padding: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 48px) 96px;
    max-width: 1320px;
    margin: 0 auto;
  }

  .pcac__head { max-width: 680px; margin: 0 auto 56px; text-align: center; }

  .pcac__eyebrow {
    color: var(--pcac-gold);
    text-transform: uppercase;
    letter-spacing: .22em;
    font-size: 11px;
    font-weight: 700;
    margin: 0 0 14px;
  }

  .pcac__head h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 300;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -.02em;
    margin: 0 0 18px;
  }

  .pcac__intro { color: rgba(245,240,230,.7); font-size: 16px; line-height: 1.7; margin: 0; }

  .pcac__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .pcac-card { display: block; text-decoration: none; color: inherit; }

  .pcac-card__media {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--pcac-charcoal);
    margin-bottom: 16px;
  }

  .pcac-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .4s ease, transform .5s ease;
  }

  .pcac-card__img--secondary { opacity: 0; }
  .pcac-card:hover .pcac-card__img--secondary { opacity: 1; }
  .pcac-card:hover .pcac-card__img--primary { transform: scale(1.02); }

  .pcac-card__placeholder {
    width: 100%; height: 100%;
    background: radial-gradient(circle at center, rgba(176,141,87,.1), transparent 60%);
  }

  .pcac-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: rgba(11,11,12,.85);
    color: rgba(245,240,230,.8);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid rgba(176,141,87,.3);
  }

  .pcac-card__name { font-size: 15px; font-weight: 700; margin: 0 0 6px; }

  .pcac-card__price { font-size: 14px; color: var(--pcac-gold); margin: 0; display: flex; gap: 10px; }
  .pcac-card__price s { color: rgba(245,240,230,.4); }

  .pcac__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 64px;
    font-size: 13px;
    letter-spacing: .08em;
  }
  .pcac__pagination a { color: var(--pcac-gold); text-decoration: none; }
  .pcac__pagination span { color: rgba(245,240,230,.5); }

  .pcac__empty { text-align: center; padding: 80px 0; color: rgba(245,240,230,.7); }

  .pcac-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 16px 34px;
    background: var(--pcac-gold);
    color: var(--pcac-obsidian);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid var(--pcac-gold);
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .pcac__grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }

  @media (max-width: 480px) {
    .pcac__grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

{% schema %}
{
  "name": "PCA Collection Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pussycat Alley"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro copy (used if collection has no description)",
      "default": "Luxury layers cut for Sphynx, Devon Rex, and every hairless breed — for cats who were never ordinary."
    }
  ]
}
{% endschema %}
