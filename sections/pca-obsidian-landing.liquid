    .pca-sticky-cta__price {
      color: #c9a84c;
      font-size: 16px;
      font-weight: 700;
    }

    .pca-sticky-cta__btn {
      flex-shrink: 0;
      padding: 14px 24px;
      font-size: 12px;
      white-space: nowrap;
    }
