<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  {%- comment -%}
    shop.pussycatalley.com is checkout-only; the storefront is pussycatalley.com (headless).
    Forward the old storefront pages there, keeping any query string (UTMs). Forwarded:
    home, products (same handles), collections, collection list, search, the old fountain page.
    NOT forwarded: cart, checkout, account, policies and pages (the privacy opt-out page lives
    here), 404, password. Skipped inside the theme editor so the theme can still be edited.
  {%- endcomment -%}
  {%- assign pca_target = '' -%}
  {%- case template.name -%}
    {%- when 'index' -%}
      {%- assign pca_target = 'https://pussycatalley.com/' -%}
    {%- when 'product' -%}
      {%- assign pca_handle = product.handle | url_encode -%}{%- assign pca_target = 'https://pussycatalley.com/products/' | append: pca_handle -%}
    {%- when 'collection' or 'list-collections' or 'search' -%}
      {%- assign pca_target = 'https://pussycatalley.com/shop' -%}
    {%- when 'page' -%}
      {%- if template.suffix == 'obsidian-fountain' -%}
        {%- assign pca_target = 'https://pussycatalley.com/' -%}
      {%- endif -%}
  {%- endcase -%}
  {%- if pca_target != '' and request.design_mode == false -%}
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ pca_target }}">
    <script>window.location.replace({{ pca_target | json }} + window.location.search);</script>
    <noscript><meta http-equiv="refresh" content="0; url={{ pca_target }}"></noscript>
  {%- endif -%}
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
  <meta name="theme-color" content="#070707">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {%- if pca_target == blank -%}<link rel="canonical" href="{{ canonical_url }}">{%- endif -%}

  {% if settings.favicon %}
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
  {% endif %}

  <!-- Google Fonts — required for PCA luxury editorial typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=DM+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      padding: 0;
      background: #070707;
      color: #f5f0e8;
      -webkit-font-smoothing: antialiased;
    }
    img, video { max-width: 100%; }
    a { color: inherit; }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body>
  <a class="skip-to-content-link button visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'pca-footer' %}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>
</body>
</html>
